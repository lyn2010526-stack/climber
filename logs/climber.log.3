{"event": "\nCREATE TABLE users (\n\tid VARCHAR(36) NOT NULL, \n\temail VARCHAR(255) NOT NULL, \n\tpassword_hash VARCHAR(255) NOT NULL, \n\tis_active BOOLEAN NOT NULL, \n\tis_admin BOOLEAN NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id), \n\tUNIQUE (email)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.723730Z"}
{"event": "[no key 0.00023s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.723884Z"}
{"event": "\nCREATE TABLE tools (\n\tid VARCHAR(36) NOT NULL, \n\tname VARCHAR(100) NOT NULL, \n\tdescription TEXT NOT NULL, \n\ttype VARCHAR(20) NOT NULL, \n\tparameters JSON NOT NULL, \n\tmcp_config JSON, \n\tis_active BOOLEAN NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id), \n\tUNIQUE (name)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.724688Z"}
{"event": "[no key 0.00019s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.724829Z"}
{"event": "\nCREATE TABLE checkpoints (\n\tid VARCHAR(36) NOT NULL, \n\tsession_id VARCHAR(36) NOT NULL, \n\tthread_id VARCHAR(36) NOT NULL, \n\tmessages TEXT NOT NULL, \n\titeration INTEGER NOT NULL, \n\tstatus VARCHAR(20) NOT NULL, \n\ttool_results TEXT NOT NULL, \n\tmetadata TEXT NOT NULL, \n\tparent_id VARCHAR(36), \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.725424Z"}
{"event": "[no key 0.00018s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.725599Z"}
{"event": "CREATE INDEX ix_checkpoints_session_id ON checkpoints (session_id)", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.726057Z"}
{"event": "[no key 0.00015s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:44.726190Z"}
