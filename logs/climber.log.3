{"event": "\nCREATE TABLE agent_group_guardrails (\n\tid VARCHAR(36) NOT NULL, \n\tgroup_id VARCHAR(36) NOT NULL, \n\ttask_id VARCHAR(36), \n\tname VARCHAR(100) NOT NULL, \n\tdescription TEXT NOT NULL, \n\tguardrail_type VARCHAR(20) NOT NULL, \n\tvalidation_prompt TEXT, \n\tvalidation_function VARCHAR(255), \n\tschema JSON, \n\tmax_retries INTEGER NOT NULL, \n\tretry_prompt_template TEXT, \n\tis_active BOOLEAN NOT NULL, \n\tpass_count INTEGER NOT NULL, \n\tfail_count INTEGER NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tupdated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(group_id) REFERENCES agent_groups (id), \n\tFOREIGN KEY(task_id) REFERENCES agent_group_tasks (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:52.479706Z"}
