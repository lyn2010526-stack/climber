{"event": "\nCREATE TABLE agent_group_task_checkpoints (\n\tid VARCHAR(36) NOT NULL, \n\tgroup_id VARCHAR(36) NOT NULL, \n\ttask_id VARCHAR(36) NOT NULL, \n\tstatus VARCHAR(20) NOT NULL, \n\tcurrent_round INTEGER NOT NULL, \n\tmax_rounds INTEGER NOT NULL, \n\ttotal_tokens INTEGER NOT NULL, \n\thistory JSON NOT NULL, \n\tcurrent_artifact TEXT NOT NULL, \n\tall_issues JSON NOT NULL, \n\tworker_config JSON NOT NULL, \n\treviewer_configs JSON NOT NULL, \n\tmanager_config JSON NOT NULL, \n\ttask_description TEXT NOT NULL, \n\tcontext_data JSON NOT NULL, \n\toutput_schema JSON NOT NULL, \n\tstructured_output JSON NOT NULL, \n\thuman_review_required BOOLEAN NOT NULL, \n\thuman_review_status VARCHAR(20) NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tupdated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tcompleted_at DATETIME, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(group_id) REFERENCES agent_groups (id), \n\tFOREIGN KEY(task_id) REFERENCES agent_group_tasks (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:43.869177Z"}
