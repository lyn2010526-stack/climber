{"event": "\nCREATE TABLE agent_group_tasks (\n\tid VARCHAR(36) NOT NULL, \n\tgroup_id VARCHAR(36) NOT NULL, \n\tdescription TEXT NOT NULL, \n\tstatus VARCHAR(20) NOT NULL, \n\tworker_id VARCHAR(36), \n\treviewer_ids JSON NOT NULL, \n\tmax_rounds INTEGER NOT NULL, \n\tcurrent_round INTEGER NOT NULL, \n\tdependencies JSON NOT NULL, \n\tcontext JSON NOT NULL, \n\tparent_task_id VARCHAR(36), \n\tguardrails JSON NOT NULL, \n\thuman_review_required BOOLEAN NOT NULL, \n\thuman_review_status VARCHAR(20) NOT NULL, \n\thuman_review_comment TEXT, \n\toutput_schema JSON NOT NULL, \n\tfinal_output TEXT, \n\tstructured_output JSON NOT NULL, \n\ttotal_tokens INTEGER NOT NULL, \n\tstarted_at DATETIME, \n\tpaused_at DATETIME, \n\tcompleted_at DATETIME, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tstep_callback VARCHAR(255), \n\ttask_callback VARCHAR(255), \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(group_id) REFERENCES agent_groups (id), \n\tFOREIGN KEY(worker_id) REFERENCES agent_group_members (id), \n\tFOREIGN KEY(parent_task_id) REFERENCES agent_group_tasks (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:07:40.475341Z"}
