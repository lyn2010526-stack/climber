{"event": "\nCREATE TABLE agent_group_memories (\n\tid VARCHAR(36) NOT NULL, \n\tgroup_id VARCHAR(36) NOT NULL, \n\ttask_id VARCHAR(36), \n\tmemory_type VARCHAR(30) NOT NULL, \n\tmemory_category VARCHAR(30) NOT NULL, \n\tcontent TEXT NOT NULL, \n\tsummary TEXT NOT NULL, \n\tembedding JSON, \n\timportance FLOAT NOT NULL, \n\trecency_score FLOAT NOT NULL, \n\taccess_count INTEGER NOT NULL, \n\tsource_agent_id VARCHAR(36), \n\tsource_message_id VARCHAR(36), \n\ttags JSON NOT NULL, \n\tmetadata JSON NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tupdated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tlast_accessed_at DATETIME, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(group_id) REFERENCES agent_groups (id), \n\tFOREIGN KEY(task_id) REFERENCES agent_group_tasks (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T13:06:02.311140Z"}
