{"event": "[no key 0.00015s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:38.486227Z"}
{"event": "CREATE INDEX ix_checkpoints_thread_id ON checkpoints (thread_id)", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:38.486702Z"}
{"event": "[no key 0.00018s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:38.486845Z"}
{"event": "\nCREATE TABLE workflows (\n\tid VARCHAR(36) NOT NULL, \n\tuser_id VARCHAR(36) NOT NULL, \n\tname VARCHAR(255) NOT NULL, \n\tdescription TEXT NOT NULL, \n\tnodes JSON NOT NULL, \n\tedges JSON NOT NULL, \n\tis_template BOOLEAN NOT NULL, \n\ttemplate_id VARCHAR(100), \n\trun_count INTEGER NOT NULL, \n\tlast_status VARCHAR(20) NOT NULL, \n\tschedule VARCHAR(100), \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tupdated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:38.487488Z"}
