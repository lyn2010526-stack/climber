{"event": "\nCREATE TABLE users (\n\tid VARCHAR(36) NOT NULL, \n\temail VARCHAR(255) NOT NULL, \n\tpassword_hash VARCHAR(255) NOT NULL, \n\tis_active BOOLEAN NOT NULL, \n\tis_admin BOOLEAN NOT NULL, \n\tcreated_at DATETIME DEFAULT CURRENT_TIMESTAMP NOT NULL, \n\tPRIMARY KEY (id), \n\tUNIQUE (email)\n)\n\n", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:32.001372Z"}
{"event": "[no key 0.00024s] ()", "level": "info", "logger": "sqlalchemy.engine.Engine", "timestamp": "2026-07-28T12:25:32.001552Z"}
