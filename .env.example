# App
APP_NAME=Climber
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
APP_SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/climber.db
# Docker Compose passes this value as DATABASE_PASSWORD to the API.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
# Docker Compose passes this value directly to Redis and the API.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Vector Store
VECTOR_STORE_PATH=./data/chroma

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o-mini

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Telegram Remote Control (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_PROVIDER=openai
TELEGRAM_DEFAULT_MODEL=gpt-4o-mini
TELEGRAM_SYSTEM_PROMPT=You are a helpful autonomous agent.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=

# Run protocol observability (unified-agent-run-protocol)
RUN_RAW_PAYLOAD_POLICY=standard
RUN_RAW_PAYLOAD_RETENTION_DAYS=7
RUN_RAW_PAYLOAD_MAX_BYTES=262144
RUN_STALE_MAX_AGE_MINUTES=120
RUN_CLEANUP_INTERVAL_MINUTES=30

# Fourth-generation emergent modules (all default OFF; master switch gates all)
ENABLE_FOURTH_GEN=false
ENABLE_AUTODISCOVERY=false
ENABLE_META_AGENT=false
ENABLE_GOAL_CENTERED=false
ENABLE_SWARM=false

# Architecture-v2 modules (all default OFF; master switch ENABLE_ARCH_V2 gates all)
ENABLE_ARCH_V2=false
ENABLE_PLUGIN_KERNEL=false
ENABLE_TRACE_LOG=false
ENABLE_FOUR_LAYER_MEMORY=false
ENABLE_SKILL_STORE=false
ENABLE_SELF_LEARNING=false
ENABLE_CAPABILITY=false
ENABLE_LONG_CONTEXT=false
ENABLE_INTEGRATION=false
