# App
APP_NAME=Climber
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
APP_SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/climber.db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Vector Store
VECTOR_STORE_PATH=./data/chroma

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o-mini

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Telegram Remote Control (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_PROVIDER=openai
TELEGRAM_DEFAULT_MODEL=gpt-4o-mini
TELEGRAM_SYSTEM_PROMPT=You are a helpful autonomous agent.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
