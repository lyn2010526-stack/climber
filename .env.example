# App
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
# Production Compose requires a nonempty secret supplied by the operator.
APP_SECRET_KEY=
TRUSTED_PROXIES=127.0.0.1,::1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/climber.db
# Required by docker-compose.yml, with no default password.
# Use 32+ URL-safe characters (A-Z, a-z, 0-9, _, -); 64 random hex is suitable.
# Compose builds DATABASE_URL from this raw password and overrides SQLite above.
POSTGRES_PASSWORD=

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Vector Store
VECTOR_STORE_PATH=./data/chroma

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL_SPEC=gpt-4o-mini

# Auth
# ENABLE_AUTH auto-derives from APP_ENV when unset:
# development -> disabled; production/staging -> enabled (boot fails if disabled).
# ENABLE_AUTH=
# Required in production/staging when the users table is empty.
# Set an operator-provided bootstrap password; no production fallback exists.
# Existing users are preserved; changing this value does not reset passwords.
INITIAL_ADMIN_PASSWORD=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Telegram Remote Control (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_PROVIDER=openai
TELEGRAM_DEFAULT_MODEL=gpt-4o-mini
TELEGRAM_SYSTEM_PROMPT=You are a helpful autonomous agent.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
