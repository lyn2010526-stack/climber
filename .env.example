# App
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be empty here: a placeholder value is treated as "not configured" and
# will not start a production deployment.
APP_SECRET_KEY=
TRUSTED_PROXIES=127.0.0.1,::1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/climber.db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Vector Store
VECTOR_STORE_PATH=./data/chroma

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL_SPEC=gpt-4o-mini

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
# This variable is now actually read. "*" is rejected while
# CORS_ALLOW_CREDENTIALS is true, because that combination reflects any origin
# together with cookies.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Server
HOST=0.0.0.0
PORT=8000

# Telegram Remote Control (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_PROVIDER=openai
TELEGRAM_DEFAULT_MODEL=gpt-4o-mini
TELEGRAM_SYSTEM_PROMPT=You are a helpful autonomous agent.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=

# Multi-agent crew scheduling
# Ceiling on crew tasks in flight at once. A crew task is a full agent turn, so
# this protects the shared engine session registry and the model provider rate
# limit. Unparsable or non-positive values fall back to 5.
CLIMBER_CREW_MAX_CONCURRENCY=5
