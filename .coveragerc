[run]
source = app,tests,skills,agent-engine
omit = 
    */tests/*
    */__pycache__/*
    */node_modules/*
    */venv/*
    */.venv/*
    */site-packages/*
    */app_legacy_conflict/*
    */climber_legacy_conflict/*
branch = True
parallel = True

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = coverage_report
